<?xml version="1.0" encoding="utf-8"?>
<!--
  Soft, warm, blurred backdrop — matches the "Коралл→Розовый" reference
  card: a pale cream base with three overlapping warm pastel blobs
  (coral-peach, pink, cream) that fade to transparent at their edges,
  approximating a Gaussian blur since VectorDrawable has no blur filter.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- base -->
    <path android:pathData="M0,0h108v108h-108z" android:fillColor="#FFF9F5" />

    <!-- top-left coral-peach blob -->
    <path android:pathData="M 34,4 m -38,0 a 38,38 0 1,0 76,0 a 38,38 0 1,0 -76,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="34"
                android:centerY="4"
                android:gradientRadius="38"
                android:startColor="#FFFFE1D2"
                android:endColor="#00FFE1D2" />
        </aapt:attr>
    </path>

    <!-- top-right pink blob -->
    <path android:pathData="M 96,26 m -35,0 a 35,35 0 1,0 70,0 a 35,35 0 1,0 -70,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="96"
                android:centerY="26"
                android:gradientRadius="35"
                android:startColor="#FFFFDCEA"
                android:endColor="#00FFDCEA" />
        </aapt:attr>
    </path>

    <!-- bottom warm cream blob -->
    <path android:pathData="M 58,102 m -40,0 a 40,40 0 1,0 80,0 a 40,40 0 1,0 -80,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="58"
                android:centerY="102"
                android:gradientRadius="40"
                android:startColor="#FFFFF3E0"
                android:endColor="#00FFF3E0" />
        </aapt:attr>
    </path>

</vector>
